            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/QrCodeStateModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/QrCodeStateModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/QrCodes/{id}": {
      "put": {
        "tags": [
          "QrCodes"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
